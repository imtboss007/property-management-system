# Supabase project connection (use the public/publishable anon key, never service_role)
# Create .env.local from this file for a local build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy API placeholder, retained for future integrations
VITE_API_BASE_URL=

# These must only be stored on a trusted server, never exposed as VITE_ variables.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
