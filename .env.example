# Optional cloud authentication. Leave both values blank for local-only mode.
# Use the Project URL and publishable/anon key from your Supabase project.
# NEVER use a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public feature switch only. The bridge token stays in Supabase Edge Function secrets.
VITE_AXIVESTRA_WHATSAPP_CLOUD_ENABLED=false
