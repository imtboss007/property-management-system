# Required shared AXIVESTRA authentication configuration.
# The app intentionally blocks access when either value is missing.
# Use the Project URL and publishable/anon key from the existing AXIVESTRA Supabase project.
# NEVER use a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Worker URL only. Server credentials stay in Cloudflare Worker secrets.
# Example after deployment: https://axivestra-whatsapp-worker.<account-subdomain>.workers.dev
VITE_AXIVESTRA_WHATSAPP_WORKER_URL=

# Keep disabled until the official Meta Business Platform sender and Worker are configured.
VITE_AXIVESTRA_WHATSAPP_CLOUD_ENABLED=false
