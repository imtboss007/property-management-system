{
  "name": "axivestra-property-intelligence",
  "version": "1.1.10",
  "private": true,
  "type": "module",
  "description": "AXIVESTRA asset intelligence workspace for Windows, Android, and web.",
  "author": "AXIVESTRA",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64",
    "desktop:dir": "npm run build && electron-builder --dir",
    "android:sync": "npm run build && cap sync android",
    "cap:sync": "cap sync",
    "test": "node scripts/property-range-search.test.cjs && node scripts/whatsapp-contact-normalization.test.cjs && node scripts/contact-directory-dedup.test.cjs && node scripts/contact-portability.test.cjs && node scripts/personal-workspace.test.cjs && node scripts/device-sync.test.cjs && node scripts/indian-amount.test.mjs && node scripts/whatsapp-version-negotiation.test.cjs && node scripts/axivestra-visual-system.test.cjs && node scripts/company-record-pagination.test.cjs && node scripts/universal-interface.test.cjs && node scripts/workspace-backup.test.cjs && node scripts/local-first-entry.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@whiskeysockets/baileys": "6.7.24",
    "qrcode": "^1.5.4",
    "dexie": "^4.0.8",
    "@supabase/supabase-js": "^2.118.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@playwright/test": "^1.56.1"
  },
  "build": {
    "appId": "com.estateflow.propertymanagement",
    "productName": "AXIVESTRA",
    "asar": true,
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AXIVESTRA-Setup-${version}-${arch}.${ext}",
      "icon": "build/axivestra.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AXIVESTRA"
    }
  }
}
