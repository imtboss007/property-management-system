# Copy to .env on the server. Never commit real credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Generate a random value of at least 32 characters; this authenticates ChatGPT/MCP clients.
BRIDGE_BEARER_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
# Prefer a private Docker network URL if AnythingLLM runs on the same server.
ANYTHINGLLM_BASE_URL=http://anythingllm:3001
ANYTHINGLLM_API_KEY=replace-with-anythingllm-api-key
ANYTHINGLLM_WORKSPACE_SLUG=replace-with-workspace-slug
REQUEST_TIMEOUT_MS=30000
MAX_MESSAGE_CHARS=12000