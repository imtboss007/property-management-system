# EstateFlow bridge API token. Use a long random secret (at least 32 characters).
ESTATEFLOW_BRIDGE_TOKEN=replace_with_a_random_secret_at_least_32_characters
# Separate webhook secret; configure the gateway to sign/call the webhook with this secret.
ESTATEFLOW_WEBHOOK_TOKEN=replace_with_a_different_random_secret_at_least_32_chars
# Public HTTPS URL where the gateway sends inbound messages to pause follow-ups.
# Leave blank until the hub is reachable through a public HTTPS endpoint.
ESTATEFLOW_PUBLIC_WEBHOOK_URL=

# auto detects the configured gateway. If both are configured, OpenWA is the single active transport.
# This is deliberately not dual-send: one queued message must be sent by one transport only.
ESTATEFLOW_GATEWAY_PROVIDER=auto

# OpenWA API, including its /api prefix. Leave blank if not used.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# WA-AKG API, including its /api prefix. Leave blank if not used.
WA_AKG_BASE_URL=
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=

# Used to allow HTTP to another service on a trusted private Docker/LAN network.
# Prefer HTTPS for any gateway reached across a network you do not control.
ALLOW_INSECURE_GATEWAY_HTTP=false

# Docker host bind address. Keep 127.0.0.1 unless exposing only on a firewalled private LAN.
HUB_BIND_IP=127.0.0.1
HOST=0.0.0.0
PORT=47822
ESTATEFLOW_DATA_DIR=./data
MAX_DAILY_SENDS=60
SEND_COOLDOWN_MS=12000
REQUEST_TIMEOUT_MS=10000
